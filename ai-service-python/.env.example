# Python AI Service configuration. Copy to `.env` and fill in secrets.

LOG_LEVEL=INFO

# REST API port. gRPC always listens on 50051.
API_PORT=8000

# --- LLM provider: gemini (cloud) | ollama (local) ---
LLM_PROVIDER=gemini

# Required only when LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Used when LLM_PROVIDER=ollama. OLLAMA_MODEL_LIGHT defaults to OLLAMA_MODEL_HEAVY.
# The agent path needs a tool-calling model: llama3.1:8b has it, llama3:8b does not.
OLLAMA_MODEL_HEAVY=llama3.1:8b
OLLAMA_MODEL_LIGHT=llama3.1:8b

# Hard cap on agent<->tool loops per quest event, before the in-character fallback.
AGENT_MAX_ITERATIONS=5

# Embeddings always run locally on Ollama, whichever chat provider is selected.
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# --- Vector store: faiss (default, in-process) | qdrant (scale-out) ---
# With qdrant, start it first: docker compose up -d qdrant
VECTOR_STORE=faiss
QDRANT_URL=http://localhost:6333

# Documents retrieved per lore query (hit@3 scoring in evals assumes k>=3).
RETRIEVER_K=3
