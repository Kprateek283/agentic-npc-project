# Root .env for `docker compose up`. Copy to `.env` and fill in.
# Per-service .env.example files (ai-service-python/, backend-go/) document running the
# services directly without Docker.

# --- Postgres (compose creates the DB with these) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentic_npc_db
# Override if host port 5432 is already taken (e.g. a native Postgres install).
POSTGRES_PORT=5432

# --- LLM provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Ollama runs on the HOST (embeddings need it in both modes). Pull the models first:
#   ollama pull nomic-embed-text
#   ollama pull llama3.1:8b        # only for LLM_PROVIDER=ollama
# Containers reach the host Ollama via the Docker host gateway (default below). Ollama must
# listen on 0.0.0.0, not its default 127.0.0.1, or the gateway connection is refused:
#   systemd:  sudo systemctl edit ollama  ->  [Service]\nEnvironment=OLLAMA_HOST=0.0.0.0:11434
#   manual:   OLLAMA_HOST=0.0.0.0:11434 ollama serve
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL_HEAVY=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# --- Vector store: faiss (default) | qdrant ---
VECTOR_STORE=faiss

# --- Semantic response cache (C4): reuse answers for paraphrased lore questions ---
# In-process per-NPC cache; only near-neutral emotional contexts are cached. Threshold is
# cosine similarity on nomic-embed-text (0.90 tuned so same-topic/different-intent questions
# never false-hit). Set SEMANTIC_CACHE_ENABLED=false to disable.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_MAX_PER_NPC=128

# --- LangSmith tracing (C5): step-by-step traces of the RAG chain and agent loop ---
# Disabled by default. To enable, set your key and flip tracing on; see docs/langsmith.md.
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=agentic-npc
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- gRPC resilience (Go orchestrator -> AI service) ---
# Per-call deadline in seconds. Default 40 covers worst-case local Ollama inference
# (~26s) with headroom; on AI failure the orchestrator retries once, then replies with a
# graceful in-character fallback line instead of an error.
AI_CALL_TIMEOUT=40

# --- Published host ports ---
SERVER_PORT=8080
AI_API_PORT=8000
AI_GRPC_PORT=50051
