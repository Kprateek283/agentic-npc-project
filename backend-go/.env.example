# Go orchestrator configuration. Copy to `.env` and fill in credentials.

POSTGRES_DSN="postgres://postgres:changeme@localhost:5432/agentic_npc_db?sslmode=disable"
REDIS_ADDR="localhost:6379"

# HTTP + WebSocket listen port.
SERVER_PORT=8080

# Shared game data directory (defaults to ../gamedata).
GAMEDATA_DIR="../gamedata"

# Enable admin commands (ADMIN_SET_TRUST, ADMIN_SET_QUEST_STAGE).
ADMIN_ENABLED=false

# Comma-separated list of allowed WebSocket origins (null = the browser demo opened by double-clicking index.html).
ALLOWED_ORIGINS=null

# Per-player LLM rate limit (0 disables) and window duration in seconds.
LLM_RATE_LIMIT=20
LLM_RATE_WINDOW_SECONDS=60


# Python AI service gRPC address, and the per-call deadline in seconds.
AI_SERVICE_ADDR="localhost:50051"
AI_CALL_TIMEOUT=40
